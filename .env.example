# Скопируйте этот файл в .env.local (локально) или добавьте переменные
# в настройках хостинга (Vercel → Project → Settings → Environment Variables).
# Подробно — в HOW_TO_UPDATE.md.

# ID Google Таблицы (часть ссылки между /d/ и /edit)
GOOGLE_SHEET_ID=1T3SgqBTTdbUlBjC4UnRKk0G8mbqJK-5RJigP7azr3Rc

# Ключ Google API (рекомендуется). Если пусто — листы читаются как CSV
# по списку из src/config/site.ts (csvTabs).
GOOGLE_API_KEY=

# Листы, которые не показывать на сайте (через запятую)
EXCLUDED_SHEETS=ОПТ

# Лист с оптовыми ценами для вкладки «Акции и ОПТ» (пусто — раздел без цен)
WHOLESALE_SHEET=ОПТ

# Секрет для мгновенного обновления сайта (/api/revalidate?secret=...)
# Придумайте длинную случайную строку из латинских букв и цифр.
REVALIDATE_SECRET=

# Telegram менеджера (без @)
NEXT_PUBLIC_TG_MANAGER=VapeTochkaManager

# demo — показать демо-данные без подключения к таблице
# CATALOG_SOURCE=demo
