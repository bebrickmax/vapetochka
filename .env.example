# Скопируйте этот файл в .env.local (локально) или добавьте переменные
# в настройках хостинга (Vercel → Project → Settings → Environment Variables).
# Подробно — в HOW_TO_UPDATE.md.

# ID Google Таблиц (часть ссылки между /d/ и /edit)
# Основной склад
GOOGLE_SHEET_ID=1T3SgqBTTdbUlBjC4UnRKk0G8mbqJK-5RJigP7azr3Rc
# Точка «Каменная Горка» (самовывоз)
GOOGLE_SHEET_ID_KG=1fTaiMEO_YZWP9XLl2aSEXZvGDNRurphBvkzDKKjt-H0

# Ключ Google API (необязательно). Если пусто — список листов и фото читаются
# из открытой по ссылке таблицы, данные — CSV-выгрузкой.
GOOGLE_API_KEY=

# Листы, которые не показывать на сайте (через запятую)
EXCLUDED_SHEETS=ОПТ

# Лист с оптовыми ценами для вкладки «Акции и ОПТ» (пусто — раздел без цен)
WHOLESALE_SHEET=ОПТ

# Секрет для мгновенного обновления сайта (/api/revalidate?secret=...)
# Придумайте длинную случайную строку из латинских букв и цифр.
REVALIDATE_SECRET=

# Telegram менеджера (без @)
NEXT_PUBLIC_TG_MANAGER=VapeTochkaManager

# demo — показать демо-данные без подключения к таблице
# CATALOG_SOURCE=demo

# ─── Админка и база данных (см. ADMIN.md) ───────────────────────────────────
# Пароль входа в /admin (не короче 8 символов). Смена пароля завершает все сессии.
ADMIN_PASSWORD=
# Supabase: Project URL и секретный ключ (Settings → API Keys: sb_secret_… или legacy service_role).
# Пока не заданы — каталог работает от Google Таблиц, как раньше.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
